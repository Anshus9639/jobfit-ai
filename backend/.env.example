# --- CORS ---
# Comma-separated list of allowed frontend origins.
# Use "*" to allow all origins (fine for local dev, not recommended for production).
# Example for production: https://jobfit-ai.vercel.app
ALLOWED_ORIGINS=*

# --- Semantic similarity provider ---
# huggingface (default) | openai | local
#   huggingface: HF Inference Providers feature-extraction (free tier available)
#   openai:      any OpenAI-compatible /embeddings endpoint
#   local:       SentenceTransformer in-process (needs requirements-local.txt)
EMBEDDINGS_PROVIDER=huggingface

# Never commit a real key. On Render set this in the dashboard as a secret.
EMBEDDINGS_API_KEY=

# Optional overrides (defaults shown)
# EMBEDDINGS_BASE_URL=https://router.huggingface.co/hf-inference
# EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDINGS_TIMEOUT_SECONDS=10
# EMBEDDINGS_MAX_RETRIES=2
# EMBEDDINGS_RETRY_BACKOFF_SECONDS=0.5

# OpenAI-compatible example:
# EMBEDDINGS_PROVIDER=openai
# EMBEDDINGS_BASE_URL=https://api.openai.com/v1
# EMBEDDINGS_MODEL=text-embedding-3-small
# EMBEDDINGS_API_KEY=sk-...

# --- Memory / concurrency limits ---
# MAX_CONCURRENT_ANALYSES=2
# MAX_CONCURRENCY_WAIT_SECONDS=15
# MAX_PDF_SIZE_BYTES=5242880
# MAX_PDF_PAGES=20
# MAX_JD_LENGTH=20000
# MAX_RESUME_TEXT_CHARS=200000
# MAX_EMBEDDING_INPUT_CHARS=8000

# --- Local provider (development only) ---
# pip install -r requirements-local.txt
# EMBEDDINGS_PROVIDER=local
# EMBEDDINGS_MODEL=all-MiniLM-L6-v2
