# Comma-separated list of allowed frontend origins for CORS.
# Use "*" to allow all origins (fine for local dev, not recommended for production).
# Example for production: https://jobfit-ai.vercel.app
ALLOWED_ORIGINS=*

# Supabase authentication and server-side usage limits.
# Public publishable key is safe for backend use; never commit a service-role key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# --- Embedding provider (semantic similarity) ---
# "huggingface" (default) or "gemini". Never commit real keys; keep them in your
# host's secret store (Render: Environment tab) or an untracked .env file.
EMBEDDING_PROVIDER=huggingface
HF_TOKEN=
# GEMINI_API_KEY=
# EMBEDDING_MODEL=            # default: BAAI/bge-small-en-v1.5
# EMBEDDING_API_URL=          # override the provider endpoint

# --- Tuning (defaults shown) ---
# EMBEDDING_TIMEOUT_SECONDS=10
# EMBEDDING_TOTAL_TIMEOUT_SECONDS=25
# EMBEDDING_MAX_RETRIES=2
# MAX_CONCURRENT_ANALYSES=2
# MAX_WAITING_ANALYSES=4
# MAX_PDF_PAGES=15
