# Base URL of the deployed FastAPI backend (no trailing slash).
# Local dev default: http://localhost:8000
# Production example: https://jobfit-ai-backend.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase project settings (publishable/anon key is safe for browser use).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Stripe server-side secrets. Never prefix these with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...
NEXT_PUBLIC_APP_URL=http://localhost:3000
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key